---
/**
 * The home page's hero (replaces Starlight's): the pitch on one side and a 3D scene on the other, with no
 * code in sight. A button reveals the real source of the component both devices render (`HeroCard.tsx`).
 */
import { Code, LinkButton } from '@astrojs/starlight/components';
import Hero3D from './Hero3D.tsx';
import cardSource from './HeroCard.tsx?raw';

const { data } = Astro.locals.starlightRoute.entry;
const { title = data.title, tagline, actions = [] } = data.hero || {};
---

<div class="iso-landing">
  <div class="iso-landing__grid">
    <div class="iso-landing__copy">
      <h1 id="_top" data-page-title set:html={title} />
      {tagline && <p class="iso-landing__tagline" set:html={tagline} />}
      {actions.length > 0 && (
        <div class="iso-landing__actions">
          {actions.map(({ icon, link: href, text, variant }) => (
            <LinkButton {href} {variant} icon={icon?.name}>{text}</LinkButton>
          ))}
        </div>
      )}
    </div>

    <div class="iso-landing__stage" role="img" aria-label="One Isoform component running in a browser window and on a phone, in 3D">
      <Hero3D client:only="react" />
    </div>
  </div>

  <div class="hero-showcase">
    <div class="hero-showcase__bar">
      <button type="button" class="hero-showcase__toggle" aria-expanded="false" aria-controls="hero-code">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="m8 7-5 5 5 5M16 7l5 5-5 5M14 4l-4 16"></path>
        </svg>
        <span data-label>View the code</span>
      </button>
      <p class="hero-showcase__hint">Both screens run this same component. Press <strong>Deploy</strong> on either one.</p>
    </div>

    <div class="hero-showcase__code" id="hero-code" data-open="false">
      <div>
        <Code code={cardSource.trim()} lang="tsx" title="HeroCard.tsx" />
      </div>
    </div>
  </div>
</div>

<script>
  for (const section of document.querySelectorAll<HTMLElement>('.hero-showcase')) {
    const toggle = section.querySelector<HTMLButtonElement>('.hero-showcase__toggle');
    const panel = section.querySelector<HTMLElement>('.hero-showcase__code');
    const label = toggle?.querySelector<HTMLElement>('[data-label]');
    toggle?.addEventListener('click', () => {
      const open = panel?.dataset.open !== 'true';
      if (panel) panel.dataset.open = String(open);
      toggle.setAttribute('aria-expanded', String(open));
      if (label) label.textContent = open ? 'Hide the code' : 'View the code';
    });
  }
</script>

<style is:global>
  /* The hero breaks out of the 50rem content column. */
  .iso-landing {
    position: relative;
    left: 50%;
    width: min(1240px, calc(100vw - 2rem));
    transform: translateX(-50%);
    margin-block: 0 2rem;
  }

  .iso-landing__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    align-items: center;
    gap: 0.5rem;
  }

  .iso-landing__copy {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.1rem;
    padding-top: 1.5rem;
    text-align: center;
  }

  .iso-landing__copy h1 {
    margin: 0;
    font-size: clamp(2.6rem, 7vw, 4.6rem);
    line-height: 1.02;
    letter-spacing: -0.03em;
    background: linear-gradient(120deg, var(--sl-color-white) 20%, var(--sl-color-accent-high) 60%, #67e8f9);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .iso-landing__tagline {
    margin: 0;
    max-width: 30rem;
    color: var(--sl-color-gray-2);
    font-size: clamp(1rem, 2.2vw, 1.2rem);
    line-height: 1.55;
  }

  .iso-landing__actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.75rem 1.25rem;
    margin-top: 0.25rem;
  }

  .iso-landing__stage {
    min-width: 0;
  }

  @media (min-width: 62rem) {
    .iso-landing__grid {
      grid-template-columns: minmax(0, 5fr) minmax(0, 8fr);
      gap: 1rem;
      min-height: min(620px, calc(100vh - 12rem));
    }

    .iso-landing__copy {
      align-items: flex-start;
      padding-top: 0;
      text-align: left;
    }

    .iso-landing__actions {
      justify-content: flex-start;
    }
  }

  .hero-showcase {
    margin-block: 0 2.5rem;
  }

  .hero-showcase__bar {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
    margin-top: 0.25rem;
  }

  .hero-showcase__toggle {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    padding: 0.65rem 1.25rem;
    border: 1px solid color-mix(in srgb, var(--sl-color-accent) 60%, transparent);
    border-radius: 999px;
    background: color-mix(in srgb, var(--sl-color-accent) 14%, transparent);
    color: var(--sl-color-white);
    font: inherit;
    font-size: var(--sl-text-sm);
    font-weight: 600;
    cursor: pointer;
    transition:
      transform 0.15s ease,
      background-color 0.2s ease,
      box-shadow 0.2s ease;
  }

  .hero-showcase__toggle:hover {
    background: color-mix(in srgb, var(--sl-color-accent) 28%, transparent);
    box-shadow: 0 0 0 4px color-mix(in srgb, var(--sl-color-accent) 18%, transparent);
  }

  .hero-showcase__toggle:active {
    transform: scale(0.97);
  }

  .hero-showcase__hint {
    margin: 0;
    color: var(--sl-color-gray-2);
    font-size: var(--sl-text-xs);
    text-align: center;
  }

  /* Opens by animating the row height; hidden content is also out of the tab order. */
  .hero-showcase__code {
    display: grid;
    grid-template-rows: 0fr;
    visibility: hidden;
    transition:
      grid-template-rows 0.45s cubic-bezier(0.2, 0.8, 0.2, 1),
      visibility 0s linear 0.45s;
  }

  .hero-showcase__code[data-open='true'] {
    grid-template-rows: 1fr;
    visibility: visible;
    transition:
      grid-template-rows 0.45s cubic-bezier(0.2, 0.8, 0.2, 1),
      visibility 0s;
  }

  .hero-showcase__code > div {
    min-height: 0;
    overflow: hidden;
    padding-top: 1rem;
  }

  /* Over the scene the devices hold still, so the buttons are easy to hit (the cube and the exploded view keep moving). */
  .iso-hero:hover .iso-sway,
  .iso-hero:hover .iso-float {
    animation-play-state: paused;
  }

  @media (prefers-reduced-motion: reduce) {
    .iso-hero *,
    .hero-showcase__code {
      animation: none !important;
      transition: none !important;
    }
  }
</style>
