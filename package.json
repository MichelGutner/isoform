{
  "name": "omnistyle",
  "version": "0.3.0",
  "description": "One styling API for React and React Native: write a component once, run it on web (React DOM) and mobile, with global theming and no providers",
  "homepage": "https://github.com/MichelGutner/stylized#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/MichelGutner/stylized.git"
  },
  "bugs": {
    "url": "https://github.com/MichelGutner/stylized/issues"
  },
  "keywords": [
    "react",
    "react-native",
    "cross-platform",
    "universal",
    "styling",
    "theme",
    "typescript",
    "css-in-js",
    "atomic-css",
    "styled-components"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "react-native": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "rm -rf dist && tspc -p tsconfig.json",
    "lint:fix": "yarn lint --fix",
    "lint": "yarn --lint",
    "test": "jest",
    "bench": "jest --config jest.bench.config.js",
    "build:dev": "yarn build && yalc push",
    "build:watch": "./watch.sh",
    "prepublishOnly": "npm run build",
    "prepack": "npm run build"
  },
  "dependencies": {
    "pdfjs-dist": "^5.6.205"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18",
    "react-native": ">=0.76"
  },
  "devDependencies": {
    "@babel/core": "^7.25.0",
    "@eslint/js": "^9.21.0",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/gitlab": "^13.2.4",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/react-native": "^13.2.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.13.9",
    "@types/react": "~19.1.17",
    "@types/react-dom": "^19.1.0",
    "babel-jest": "^29.7.0",
    "babel-plugin-module-resolver": "^5.0.2",
    "conventional-changelog-conventionalcommits": "^8.0.0",
    "eslint": "^9.21.0",
    "globals": "^16.0.0",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "metro-react-native-babel-preset": "^0.77.0",
    "react": "^19.1.0",
    "react-dom": "19.2.4",
    "react-native": "^0.81.5",
    "react-test-renderer": "^19.0.0",
    "semantic-release": "^24.2.3",
    "ts-jest": "^29.2.6",
    "ts-patch": "^3.3.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.26.0",
    "typescript-transform-paths": "^3.5.3"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "license": "MIT",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "react-native": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json",
    "./metro": "./metro.js"
  },
  "sideEffects": [
    "./dist/index.js",
    "./dist/providers/*",
    "./src/index.ts",
    "./src/providers/*"
  ],
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "!dist/**/babel.config.*",
    "!dist/**/jest.config.*",
    "README.md",
    "LICENSE",
    "src/adapters/react-native/media/**/native/**",
    "ios/**",
    "android/build.gradle",
    "android/consumer-rules.pro",
    "android/src/**",
    "omnistyle.podspec",
    "react-native.config.js",
    "metro.js",
    "scripts/setup-ios.js"
  ],
  "peerDependenciesMeta": {
    "react-dom": {
      "optional": true
    },
    "react-native": {
      "optional": true
    }
  },
  "codegenConfig": {
    "name": "OmnistyleSpec",
    "type": "components",
    "jsSrcsDir": "src/adapters/react-native/media",
    "android": {
      "javaPackageName": "com.omnistyle"
    },
    "ios": {
      "componentProvider": {
        "OmniVideoView": "OmniVideoView",
        "OmniAudioView": "OmniAudioView",
        "OmniPdfView": "OmniPdfView"
      }
    }
  },
  "bin": {
    "omnistyle-setup-ios": "scripts/setup-ios.js"
  }
}
