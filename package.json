{
  "name": "isoform",
  "version": "0.1.0",
  "description": "One styling API for React and React Native: write a component once, run it on web (React DOM) and mobile, with global theming and no providers",
  "homepage": "https://github.com/MichelGutner/isoform#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MichelGutner/isoform.git"
  },
  "bugs": {
    "url": "https://github.com/MichelGutner/isoform/issues"
  },
  "keywords": [
    "react",
    "react-native",
    "cross-platform",
    "universal",
    "styling",
    "theme",
    "typescript",
    "css-in-js",
    "atomic-css",
    "styled-components"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "react-native": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "rm -rf dist && tspc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint src metro.js react-native.config.js scripts",
    "lint:fix": "eslint src metro.js react-native.config.js scripts --fix",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "check:package": "node scripts/check-package.js",
    "check:swift": "scripts/check-swift.sh",
    "check:android": "scripts/check-android.sh",
    "verify": "yarn lint && yarn typecheck && yarn test && yarn build && yarn check:package",
    "verify:all": "yarn verify && yarn check:swift && yarn check:android",
    "release": "scripts/release.sh",
    "release:dry": "scripts/release.sh --dry-run",
    "bench": "jest --config jest.bench.config.js",
    "build:dev": "yarn build && yalc push",
    "build:watch": "./watch.sh",
    "prepack": "npm run build",
    "prepare": "husky || true"
  },
  "dependencies": {
    "pdfjs-dist": "6.5.438"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18",
    "react-native": ">=0.76",
    "react-native-svg": ">=15"
  },
  "devDependencies": {
    "@babel/core": "^7.29.13",
    "@eslint/js": "^10.0.1",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/react-native": "^13.2.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^26.6.6",
    "@types/react": "~19.3.0",
    "@types/react-dom": "^19.1.0",
    "babel-jest": "^29.7.0",
    "babel-plugin-module-resolver": "^5.0.3",
    "eslint": "10.15.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "^16.0.0",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "metro-react-native-babel-preset": "^0.77.0",
    "react": "^19.3.1",
    "react-dom": "19.3.1",
    "react-native": "^0.88.1",
    "react-test-renderer": "^19.3.1",
    "ts-jest": "^29.4.15",
    "ts-patch": "^3.3.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "8.73.0",
    "typescript-transform-paths": "^3.5.3"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "license": "MIT",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "react-native": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json",
    "./metro": "./metro.js"
  },
  "sideEffects": [
    "./dist/index.js",
    "./dist/providers/*",
    "./src/index.ts",
    "./src/providers/*"
  ],
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "!dist/**/babel.config.*",
    "!dist/**/jest.config.*",
    "README.md",
    "LICENSE",
    "src/adapters/react-native/**/native/**",
    "ios/**",
    "android/build.gradle",
    "android/consumer-rules.pro",
    "android/src/**",
    "isoform.podspec",
    "react-native.config.js",
    "metro.js",
    "scripts/setup-ios.js"
  ],
  "peerDependenciesMeta": {
    "react-dom": {
      "optional": true
    },
    "react-native": {
      "optional": true
    },
    "react-native-svg": {
      "optional": true
    }
  },
  "codegenConfig": {
    "name": "IsoformSpec",
    "type": "all",
    "jsSrcsDir": "src/adapters/react-native",
    "android": {
      "javaPackageName": "com.isoform"
    },
    "ios": {
      "componentProvider": {
        "IsoVideoView": "IsoVideoView",
        "IsoAudioView": "IsoAudioView",
        "IsoPdfView": "IsoPdfView",
        "IsoSheetView": "IsoSheetView",
        "IsoCameraView": "IsoCameraView",
        "IsoDatePickerView": "IsoDatePickerView",
        "IsoImageView": "IsoImageView",
        "IsoModalView": "IsoModalView"
      },
      "modulesProvider": {
        "IsoImageModule": "IsoImageModule"
      }
    }
  },
  "bin": {
    "isoform-setup-ios": "scripts/setup-ios.js"
  },
  "publishConfig": {
    "access": "public"
  }
}
