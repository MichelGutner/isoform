{
  "compilerOptions": {
    "target": "esnext",
    "module": "esnext",
    "moduleResolution": "node",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "lib": ["dom", "esnext"],
    "baseUrl": ".",
    "paths": {
      "omnistyle": ["../../src/index.ts"]
    },
    "types": []
  },
  "include": ["./**/*.ts", "./**/*.tsx", "./**/*.d.ts"]
}
